# Caddy: HTTPS automático (Let's Encrypt).
#   https://<DOMINIO_BASE>               site de vendas (pasta site/); o www redireciona para ele
#   https://<SUBDOMINIO>.<DOMINIO_BASE>  o sistema (todos os escritórios)
{
	email {$ACME_EMAIL}
}

(seguranca) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$DOMINIO_BASE} {
	encode zstd gzip
	import seguranca
	# Formulário de teste grátis: o site chama o sistema no próprio domínio (sem CORS); só esta rota passa
	handle /api/publico/* {
		request_body {
			max_size 16KB
		}
		reverse_proxy contask-app:8765 {
			header_up Host {$SUBDOMINIO}.{$DOMINIO_BASE}
		}
	}
	handle {
		root * /srv/site
		file_server
	}
}

www.{$DOMINIO_BASE} {
	redir https://{$DOMINIO_BASE}{uri} permanent
}

{$SUBDOMINIO}.{$DOMINIO_BASE} {
	encode zstd gzip
	import seguranca
	# O sistema fica fora do Google: só o site de vendas é indexado
	header X-Robots-Tag "noindex, nofollow"
	# Uploads de certificado e importações: limite folgado, mas finito
	request_body {
		max_size 20MB
	}
	reverse_proxy contask-app:8765
}
