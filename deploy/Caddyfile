# Caddy: HTTPS automático (Let's Encrypt).
#   https://<SITE>.<DOMINIO_BASE>        site de vendas (pasta site/)
#   https://<SUBDOMINIO>.<DOMINIO_BASE>  o sistema (todos os escritórios)
#   https://<DOMINIO_BASE> e www         redirecionam para o site de vendas
{
	email {$ACME_EMAIL}
}

(seguranca) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$SITE}.{$DOMINIO_BASE} {
	root * /srv/site
	file_server
	encode zstd gzip
	import seguranca
}

{$DOMINIO_BASE}, www.{$DOMINIO_BASE} {
	redir https://{$SITE}.{$DOMINIO_BASE}{uri} permanent
}

{$SUBDOMINIO}.{$DOMINIO_BASE} {
	encode zstd gzip
	import seguranca
	# Uploads de certificado e importações: limite folgado, mas finito
	request_body {
		max_size 20MB
	}
	reverse_proxy contask-app:8765
}
