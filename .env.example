# Copie para .env e preencha. O .env nunca vai para o git.

# Chave-mestra Fernet (base64) que cifra os certificados. Sem ela a API não sobe.
# Gere com: .venv\Scripts\python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde uma cópia no gerenciador de senhas: sem ela, os certificados salvos não abrem.
CONTASK_CHAVE_MESTRA=

# Servidor na internet: domínios aceitos (separados por vírgula) e cookie só em HTTPS.
# CONTASK_HOSTS=app.contasknf.com.br
# CONTASK_COOKIE_SECURE=true
